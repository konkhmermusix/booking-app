# Nginx Configuration Example for Laravel (booking-app)

# OPTION 1: Direct Nginx + PHP-FPM / FastCGI (Laragon / XAMPP / Native Windows / Linux)
server {
    listen 80;
    server_name localhost 10.30.242.1; # អាចជំនួសដោយ Domain ឬ IP របស់អ្នក

    # Path ទៅកាន់ folder "public" នៃ Laravel project របស់អ្នក
    # Windows Example: root "D:/booking-app/public";
    # Linux Example:   root /var/www/booking-app/public;
    root "D:/booking-app/public";

    add_header X-Frame-Options "SAMEORIGIN";
    add_header X-Content-Type-Options "nosniff";

    index index.php index.html index.htm;

    charset utf-8;

    # Dynamic Routing សម្រាប់ Laravel SPA / Web
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    error_page 404 /index.php;

    # Pass PHP scripts ទៅកាន់ FastCGI Server (PHP-FPM / PHP-CGI)
    location ~ \.php$ {
        fastcgi_pass 127.0.0.1:9000; # ផ្លាស់ប្តូរទៅ 9000 ឬ unix socket តាម server របស់អ្នក
        fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
        include fastcgi_params;
        
        # កើន Timeout ប្រសិនបើ Upload file ឬ Slip ទូទាត់
        fastcgi_read_timeout 300;
    }

    # ហាមឃាត់ Access ទៅកាន់ hidden files (ដូចជា .env)
    location ~ /\.(?!well-known).* {
        deny all;
    }
}

